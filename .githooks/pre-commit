#!/bin/sh
# Git pre-commit hook: Kontrola technicke dokumentace README.md (Single Source of Truth)

echo "=========================================================="
echo "🔍 PRE-COMMIT KONTROLA: Technicka dokumentace (README.md)"
echo "=========================================================="

# Zjistime, jake soubory jsou ve stage pro commit
STAGED_FILES=$(git diff --cached --name-only)

# Pokud se commituji zmeny v kodu nebo konfiguraci, overime stav README.md
HAS_README=$(echo "$STAGED_FILES" | grep -E '^README\.md$' || true)

if [ -z "$HAS_README" ]; then
    echo "⚠️ UPOZORNENI: Commit neobsahuje zmeny v README.md."
    echo "Ujistete se, ze tento commit nevyzaduje zaznam novych architektonickych"
    echo "rozhodnuti, zmen v datovem modelu nebo aktualizaci deniku vyvoje."
else
    echo "✅ README.md je soucasti tohoto commitu (dokumentace aktualizovana)."
fi

echo "=========================================================="
exit 0
